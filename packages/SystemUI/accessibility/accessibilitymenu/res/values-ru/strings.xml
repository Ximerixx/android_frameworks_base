<?xml version="1.0" encoding="UTF-8"?>

<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
  <!-- String defining the service name -->
  <string name="accessibility_menu_service_name">Меню специальных возможностей</string>
  <!-- Accessibility Menu detail intro. [CHAR_LIMIT=NONE] -->
  <string name="accessibility_menu_intro">
    Меню специальных возможностей предоставляет большое меню на экране для управления устройством. Вы можете заблокировать устройство, управлять громкостью и яркостью, делать скриншоты и многое другое.
  </string>
  <!-- String defining the label for the assistant button -->
  <string name="assistant_label">Помощник</string>
  <!-- String defining utterance for the assistant button for screen readers -->
  <string name="assistant_utterance">Помощник</string>
  <!-- String defining the label for the accessibility settings button -->
  <string name="a11y_settings_label">Настройки специальных возможностей</string>
  <!-- String defining the label for the power button -->
  <string name="power_label">Питание</string>
  <!-- String defining utterance for the power button for screen readers -->
  <string name="power_utterance">Параметры питания</string>
  <!-- String defining the label for the recent apps button -->
  <string name="recent_apps_label">Недавние приложения</string>
  <!-- String defining the label for the lockscreen button -->
  <string name="lockscreen_label">Экран блокировки</string>
  <!-- String defining the label for the quick settings button -->
  <string name="quick_settings_label">Быстрые настройки</string>
  <!-- String defining the label for the notifications button -->
  <string name="notifications_label">Уведомления</string>
  <!-- String defining the label for the screenshot button -->
  <string name="screenshot_label">Скриншот</string>
  <!-- String defining the utterance for the screenshot button for screen readers -->
  <string name="screenshot_utterance">Сделать скриншот</string>
  <!-- String defining the label for the volume up/down button -->
  <string name="volume_up_label">Увеличить громкость</string>
  <string name="volume_down_label">Уменьшить громкость</string>
  <!-- String defining the label for the brightness up/down button -->
  <string name="brightness_up_label">Увеличить яркость</string>
  <string name="brightness_down_label">Уменьшить яркость</string>
  <!-- String defining the content description for the footer previous/next button -->
  <string name="previous_button_content_description">Перейти к предыдущему экрану</string>
  <string name="next_button_content_description">Перейти к следующему экрану</string>

  <string name="accessibility_menu_description">
    Меню специальных возможностей предоставляет большое меню на экране для управления устройством. Вы можете заблокировать устройство, управлять громкостью и яркостью, делать скриншоты и многое другое.
  </string>
  <!-- Short summary of app that appears as subtext on the service preference in Settings -->
  <string name="accessibility_menu_summary">Управление устройством через большое меню</string>

  <!-- String defining the settings name -->
  <string name="accessibility_menu_settings_name">Настройки меню специальных возможностей</string>

  <!-- String defining the title of Large button setting -->
  <string name="accessibility_menu_large_buttons_title">Большие кнопки</string>
  <!-- String defining the summary of Large button setting -->
  <string name="accessibility_menu_large_buttons_summary">Увеличить размер кнопок меню специальных возможностей</string>
  <!-- String defining the title of the preference to show help menu [CHAR LIMIT=40] -->
  <string name="pref_help_title">Справка</string>

  <!-- The percentage of the brightness, and double "%" is required to represent the symbol "%" -->
  <string name="brightness_percentage_label">Яркость <xliff:g id="percentage">%1$s</xliff:g> %%</string>
  <!-- The percentage of the music volume, and double "%" is required to represent the symbol "%" -->
  <string name="music_volume_percentage_label">Громкость музыки <xliff:g id="percentage">%1$s</xliff:g> %%</string>

</resources>
