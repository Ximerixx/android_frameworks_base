<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Choice in the ringtone picker.  If chosen, the default ringtone will be used. -->
    <string name="ringtone_default">Мелодия звонка по умолчанию</string>

    <!-- Choice in the notification sound picker.  If chosen, the default notification sound will be
         used. -->
    <string name="notification_sound_default">Звук уведомления по умолчанию</string>

    <!-- Choice in the alarm sound picker.  If chosen, the default alarm sound will be used. -->
    <string name="alarm_sound_default">Звук будильника по умолчанию</string>

    <!-- Text for the RingtonePicker item that allows adding a new ringtone. -->
    <string name="add_ringtone_text">Добавить мелодию звонка</string>
    <!-- Text for the RingtonePicker item that allows adding a new alarm. -->
    <string name="add_alarm_text">Добавить будильник</string>
    <!-- Text for the RingtonePicker item that allows adding a new notification. -->
    <string name="add_notification_text">Добавить уведомление</string>
    <!-- Text for the RingtonePicker item ContextMenu that allows deleting a custom ringtone. -->
    <string name="delete_ringtone_text">Удалить</string>
    <!-- Text for the Toast displayed when adding a custom ringtone fails. -->
    <string name="unable_to_add_ringtone">Не удалось добавить пользовательскую мелодию звонка</string>
    <!-- Text for the Toast displayed when deleting a custom ringtone fails. -->
    <string name="unable_to_delete_ringtone">Не удалось удалить пользовательскую мелодию звонка</string>

    <!-- Text for the name of the app. [CHAR LIMIT=12] -->
    <string name="app_label">Звуки</string>
</resources>
