<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="app_label">Оболочка</string>

    <!-- Title of notification channel for bug report related notifications. [CHAR LIMIT=50] -->
    <string name="bugreport_notification_channel">Отчёты об ошибках</string>

    <!-- Title of notification indicating a bugreport is being generated. [CHAR LIMIT=50] -->
    <string name="bugreport_in_progress_title">Отчёт об ошибке <xliff:g id="id">#%d</xliff:g> создаётся</string>
    <!-- Title of notification indicating a bugreport has been successfully captured. [CHAR LIMIT=50] -->
    <string name="bugreport_finished_title">Отчёт об ошибке <xliff:g id="id">#%d</xliff:g> создан</string>
    <!-- Title of notification indicating a bugreport is being updated before it can be shared. [CHAR LIMIT=50] -->
    <string name="bugreport_updating_title">Добавление деталей в отчёт об ошибке</string>
    <!-- Content notification indicating a bugreport is being updated before it can be shared, asking the user to wait [CHAR LIMIT=50] -->
    <string name="bugreport_updating_wait">Пожалуйста, подождите\u2026</string>

    <!-- Text of notification indicating that bugreport will appear on the phone. [CHAR LIMIT=100] -->
    <string name="bugreport_finished_text" product="watch">Отчёт об ошибке скоро появится на телефоне</string>
    <!-- Text of notification indicating that tapping will share the captured bugreport. [CHAR LIMIT=100] -->
    <string name="bugreport_finished_text" product="tv">Выберите, чтобы поделиться отчётом об ошибке</string>
    <!-- Text of notification indicating that tapping will share the captured bugreport. [CHAR LIMIT=100] -->
    <string name="bugreport_finished_text" product="default">Нажмите, чтобы поделиться отчётом об ошибке</string>
    <!-- Text of notification indicating that swipe left will share the captured bugreport, but giving user the option to wait for the screenshot. [CHAR LIMIT=100] -->
    <string name="bugreport_finished_pending_screenshot_text" product="tv">Выберите, чтобы поделиться отчётом об ошибке без скриншота, или дождитесь завершения создания скриншота</string>
    <!-- Text of notification indicating that swipe left will share the captured bugreport, but giving user the option to wait for the screenshot. [CHAR LIMIT=100] -->
    <string name="bugreport_finished_pending_screenshot_text" product="watch">Нажмите, чтобы поделиться отчётом об ошибке без скриншота, или дождитесь завершения создания скриншота</string>
    <!-- Text of notification indicating that tapping will share the captured bugreport, but giving user the option to wait for the screenshot. [CHAR LIMIT=100] -->
    <string name="bugreport_finished_pending_screenshot_text" product="default">Нажмите, чтобы поделиться отчётом об ошибке без скриншота, или дождитесь завершения создания скриншота</string>

    <!-- Body of dialog informing user about contents of a bugreport. [CHAR LIMIT=NONE] -->
    <string name="bugreport_confirm">Отчёты об ошибках содержат данные из различных файлов журналов системы, которые могут включать данные, которые вы считаете конфиденциальными (например, данные об использовании приложений и местоположении). Делитесь отчётами об ошибках только с людьми и приложениями, которым вы доверяете.</string>
    <!-- Checkbox that indicates this dialog should not be shown again when the next bugreport is taken. [CHAR LIMIT=50] -->
    <string name="bugreport_confirm_dont_repeat">Больше не показывать</string>

    <!-- Title for documents backend that offers bugreports. -->
    <string name="bugreport_storage_title">Отчёты об ошибках</string>

    <!-- Toast message sent when the bugreport file could be read. -->
    <string name="bugreport_unreadable_text">Не удалось прочитать файл отчёта об ошибке</string>
    <!-- Toast message sent when the bugreport details could not be added to the zip file. -->
    <string name="bugreport_add_details_to_zip_failed">Не удалось добавить детали отчёта об ошибке в ZIP-файл</string>

    <!-- Title for bug reports received from dumpstate without a name. [CHAR LIMIT=30]-->
    <string name="bugreport_unnamed">без названия</string>

    <!-- Title of the notification action that opens the dialog for the user-defined bug report details. -->
    <string name="bugreport_info_action">Детали</string>

    <!-- Title of the notification action that takes aditional screenshots. -->
    <string name="bugreport_screenshot_action">Скриншот</string>

    <!-- Toast message sent when the a screenshot for the bug report was taken successfully. -->
    <string name="bugreport_screenshot_taken">Скриншот успешно создан.</string>
    <!-- Toast message sent when the a screenshot for the bug report was not taken due to an error. -->
    <string name="bugreport_screenshot_failed">Не удалось создать скриншот.</string>

    <!--  Title of the dialog asking for user-defined bug report details like name, title, and description. -->
    <string name="bugreport_info_dialog_title">Детали отчёта об ошибке <xliff:g id="id">#%d</xliff:g></string>

    <!-- Text of the label identifying the bug report name, which when set will define a suffix in the
         bug report file names. [CHAR LIMIT=30] -->
    <string name="bugreport_info_name">Имя файла</string>
    <!-- Text of the label identifying the bug report title, which when set will define the
         Subject of the email message. [CHAR LIMIT=60] -->
    <string name="bugreport_info_title">Название ошибки</string>
    <!-- Text of the label identifying the bug report description, which when set will describe
         what the bug report is about. [CHAR LIMIT=NONE] -->
    <string name="bugreport_info_description">Краткое описание ошибки</string>

    <!-- Label of button that save bugreport details.  -->
    <string name="save">Сохранить</string>

    <!-- Title displayed in the activity chooser used to share the bug report [CHAR LIMIT=35]-->
    <string name="bugreport_intent_chooser_title">Поделиться отчётом об ошибке</string>
</resources>
