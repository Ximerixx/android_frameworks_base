    <!-- Description of the privileges the application will get if associated with the companion device of unspecified profile (type) [CHAR LIMIT=NONE] -->
    <string name="summary_generic">Это приложение сможет синхронизировать информацию, например имя звонящего, между вашим телефоном и выбранным устройством</string>

