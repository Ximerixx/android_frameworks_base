<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Title of the CompanionDeviceManager application. [CHAR LIMIT=50] -->
    <string name="app_label">Менеджер сопряжённых устройств</string>

    <!-- Title of the device association confirmation dialog. -->
    <string name="confirmation_title">Разрешить приложению &lt;strong&gt;<xliff:g id="app_name" example="Android Wear">%1$s</xliff:g>&lt;/strong&gt; доступ к &lt;strong&gt;<xliff:g id="device_name" example="ASUS ZenWatch 2">%2$s</xliff:g>&lt;/strong&gt;?</string>

    <!-- Description of soft discovery timeout. [CHAR LIMIT= NONE] -->
    <string name="message_discovery_soft_timeout">Убедитесь, что у этого <xliff:g id="device_type" example="phone">%1$s</xliff:g> включён <xliff:g id="discovery_method" example="Bluetooth">%2$s</xliff:g>, и держите ваш <xliff:g id="profile_name" example="watch">%3$s</xliff:g> поблизости.</string>

    <!-- Description of hard discovery timeout. [CHAR LIMIT= NONE] -->
    <string name="message_discovery_hard_timeout">Устройства не найдены. Пожалуйста, попробуйте позже.</string>

    <!-- The discovery method name for Bluetooth [CHAR LIMIT=30] -->
    <string name="discovery_bluetooth">Bluetooth</string>

    <!-- The discovery method name for Wi-Fi [CHAR LIMIT=30] -->
    <string name="discovery_wifi">Wi‑Fi</string>

    <!-- The discovery method name for both Bluetooth and Wi-Fi [CHAR LIMIT=50] -->
    <string name="discovery_mixed">Bluetooth и Wi‑Fi</string>

    <!-- ================= DEVICE_PROFILE_WATCH and null profile ================= -->

    <!-- The name of the "watch" device type [CHAR LIMIT=30] -->
    <string name="profile_name_watch">часы</string>

    <!-- Title of the device selection dialog. -->
    <string name="chooser_title_non_profile">Выберите устройство для управления приложением &lt;strong&gt;<xliff:g id="app_name" example="Android Wear">%1$s</xliff:g>&lt;/strong&gt;</string>

    <!-- Title of the multiple devices' dialog. -->
    <string name="chooser_title">Выберите <xliff:g id="profile_name" example="watch">%1$s</xliff:g> для настройки</string>

    <!-- Title of the single device scan dialog. -->
    <string name="single_device_title">Поиск <xliff:g id="profile_name" example="watch">%1$s</xliff:g></string>

    <!-- Description of the privileges the application will get if associated with the companion device of WATCH profile [CHAR LIMIT=NONE] -->
    <string name="summary_watch">Это приложение сможет синхронизировать информацию, например имя звонящего, и получать доступ к этим разрешениям на вашем <xliff:g id="device_type" example="phone">%1$s</xliff:g></string>

    <!-- ================= DEVICE_PROFILE_GLASSES ================= -->

    <!-- Title of the device association confirmation dialog for glasses. -->
    <string name="confirmation_title_glasses">Разрешить &lt;strong&gt;<xliff:g id="app_name" example="Android Wear">%1$s</xliff:g>&lt;/strong&gt; управлять &lt;strong&gt;<xliff:g id="device_name" example="Glasses">%2$s</xliff:g>&lt;/strong&gt;?</string>

    <!-- The name of the "glasses" device type [CHAR LIMIT=30] -->
    <string name="profile_name_glasses">устройство</string>

    <!-- Description of the privileges the application will get if associated with the companion device of GLASSES profile [CHAR LIMIT=NONE] -->
    <string name="summary_glasses">Это приложение сможет получать доступ к этим разрешениям на вашем <xliff:g id="device_type" example="phone">%1$s</xliff:g></string>

    <!-- ================= DEVICE_PROFILE_APP_STREAMING ================= -->

    <!-- Confirmation for associating an application with a companion device of APP_STREAMING profile (type) [CHAR LIMIT=NONE] -->
    <string name="title_app_streaming">Разрешить &lt;strong&gt;<xliff:g id="app_name" example="Exo">%1$s</xliff:g>&lt;/strong&gt; транслировать приложения и системные функции вашего <xliff:g id="device_type" example="phone">%2$s</xliff:g> на &lt;strong&gt;<xliff:g id="device_name" example="Chromebook">%3$s</xliff:g>&lt;/strong&gt;?</string>

    <!-- Summary for associating an application with a companion device of APP_STREAMING profile [CHAR LIMIT=NONE] -->
    <string name="summary_app_streaming"><xliff:g id="app_name" example="Exo">%1$s</xliff:g> получит доступ ко всему, что видно или воспроизводится на вашем <xliff:g id="device_type" example="phone">%2$s</xliff:g>, включая аудио, фотографии, платёжную информацию, пароли и сообщения.&lt;br/>&lt;br/><xliff:g id="app_name" example="Exo">%1$s</xliff:g> сможет транслировать приложения на <xliff:g id="device_name" example="Chromebook">%3$s</xliff:g> до тех пор, пока вы не отмените доступ к этому разрешению.</string>

    <!-- Description of the helper dialog for APP_STREAMING profile. [CHAR LIMIT=NONE] -->
    <string name="helper_summary_app_streaming"><xliff:g id="app_name" example="Exo">%1$s</xliff:g> запрашивает разрешение от имени <xliff:g id="device_name" example="Chromebook">%2$s</xliff:g> для трансляции приложений и системных функций с вашего <xliff:g id="device_type" example="phone">%3$s</xliff:g></string>

    <!-- ================= DEVICE_PROFILE_AUTOMOTIVE_PROJECTION ================= -->

    <!-- Confirmation for associating an application with a companion device of AUTOMOTIVE_PROJECTION profile (type) [CHAR LIMIT=NONE] -->
    <string name="title_automotive_projection"></string>

    <!-- Description of the privileges the application will get if associated with the companion device of AUTOMOTIVE_PROJECTION profile (type) [CHAR LIMIT=NONE] -->
    <string name="summary_automotive_projection"></string>

    <!-- ================= DEVICE_PROFILE_COMPUTER ================= -->

    <!-- Confirmation for associating an application with a companion device of COMPUTER profile (type) [CHAR LIMIT=NONE] -->
    <string name="title_computer">Разрешить &lt;strong&gt;<xliff:g id="app_name" example="GMS">%1$s</xliff:g>&lt;/strong&gt; доступ к этой информации с вашего <xliff:g id="device_type" example="phone">%2$s</xliff:g></string>

    <!-- Description of the privileges the application will get if associated with the companion device of COMPUTER profile (type) [CHAR LIMIT=NONE] -->
    <string name="summary_computer"></string>

    <!-- Description of the helper dialog for COMPUTER profile. [CHAR LIMIT=NONE] -->
    <string name="helper_summary_computer"><xliff:g id="app_name" example="GMS">%1$s</xliff:g> запрашивает разрешение от имени вашего <xliff:g id="device_name" example="Chromebook">%2$s</xliff:g> для доступа к фотографиям, медиафайлам и уведомлениям вашего <xliff:g id="device_type" example="phone">%3$s</xliff:g></string>

    <!-- ================= DEVICE_PROFILE_NEARBY_DEVICE_STREAMING ================= -->

    <!-- Confirmation for associating an application with a companion device of NEARBY_DEVICE_STREAMING profile (type) [CHAR LIMIT=NONE] -->
    <string name="title_nearby_device_streaming">Разрешить &lt;strong&gt;<xliff:g id="app_name" example="Exo">%1$s</xliff:g>&lt;/strong&gt; транслировать приложения вашего <xliff:g id="device_type" example="phone">%2$s</xliff:g> на &lt;strong&gt;<xliff:g id="device_name" example="Chromebook">%3$s</xliff:g>&lt;/strong&gt;?</string>

    <!-- Summary for associating an application with a companion device of NEARBY_DEVICE_STREAMING profile [CHAR LIMIT=NONE] -->
    <string name="summary_nearby_device_streaming"><xliff:g id="app_name" example="Exo">%1$s</xliff:g> получит доступ ко всему, что видно или воспроизводится на <xliff:g id="device_name" example="Chromebook">%3$s</xliff:g>, включая аудио, фотографии, платёжную информацию, пароли и сообщения.&lt;br/>&lt;br/><xliff:g id="app_name" example="Exo">%1$s</xliff:g> сможет транслировать приложения на <xliff:g id="device_name" example="Chromebook">%3$s</xliff:g> до тех пор, пока вы не отмените доступ к этому разрешению.</string>

    <!-- Description of the helper dialog for NEARBY_DEVICE_STREAMING profile. [CHAR LIMIT=NONE] -->
    <string name="helper_summary_nearby_device_streaming"><xliff:g id="app_name" example="Exo">%1$s</xliff:g> запрашивает разрешение от имени <xliff:g id="device_name" example="Chromebook">%2$s</xliff:g> для трансляции приложений с вашего <xliff:g id="device_type" example="phone">%3$s</xliff:g></string>

    <!-- ================= DEVICE_PROFILE_VIRTUAL_DEVICE ================= -->

    <!-- Confirmation for associating an application with a companion device of VIRTUAL_DEVICE profile (type) [CHAR LIMIT=NONE] -->
    <string name="title_virtual_device">Разрешить &lt;strong&gt;<xliff:g id="app_name" example="Exo">%1$s</xliff:g>&lt;/strong&gt; транслировать аудио и системные функции между вашим <xliff:g id="device_type" example="phone">%3$s</xliff:g> и &lt;strong&gt;<xliff:g id="device_name" example="Chromebook">%2$s</xliff:g>&lt;/strong&gt;?</string>

    <!-- Summary for associating an application with a companion device of VIRTUAL_DEVICE profile [CHAR LIMIT=NONE] -->
    <string name="summary_virtual_device"><xliff:g id="app_name" example="Exo">%2$s</xliff:g> получит доступ ко всему, что воспроизводится на <xliff:g id="device_name" example="Chromebook">%3$s</xliff:g>.&lt;br/>&lt;br/><xliff:g id="app_name" example="Exo">%2$s</xliff:g> сможет транслировать аудио на <xliff:g id="device_name" example="Chromebook">%3$s</xliff:g> до тех пор, пока вы не отмените доступ к этому разрешению.</string>

